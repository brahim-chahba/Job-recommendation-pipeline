AIRFLOW_UID=50000
AIRFLOW_BASE_IMAGE_NAME=apache/airflow:3.1.7
AIRFLOW_IMAGE_NAME=job-intelligence-airflow:latest
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
_PIP_ADDITIONAL_REQUIREMENTS=

# Source toggles
ENABLE_JOBSPY=1
ENABLE_FRANCE_TRAVAIL=0
ENABLE_REKRUTE=1
ENABLE_EMPLOI_MA=1
JOBSPY_SITES=indeed,linkedin

# France Travail API credentials
FRANCE_TRAVAIL_CLIENT_ID=replace_me
FRANCE_TRAVAIL_CLIENT_SECRET=replace_me
FRANCE_TRAVAIL_SCOPE=api_offresdemploiv2 o2dsoffre
FRANCE_TRAVAIL_TOKEN_URL=https://entreprise.francetravail.fr/connexion/oauth2/access_token?realm=/partenaire
FRANCE_TRAVAIL_API_BASE_URL=https://api.francetravail.io/partenaire/offresdemploi/v2
